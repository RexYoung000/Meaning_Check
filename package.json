{
  "name": "meaning-check",
  "private": true,
  "version": "0.3.3",
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "wxt",
    "build": "node scripts/prepare-release.mjs && wxt build",
    "zip": "node scripts/prepare-release.mjs && wxt zip",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check:package": "node scripts/check-package.mjs",
    "postinstall": "wxt prepare",
    "icons": "node scripts/generate-icons.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.0.0",
    "jsdom": "^29.0.0",
    "typescript": "5.9.3",
    "vitest": "5.0.4",
    "wxt": "0.21.4"
  },
  "license": "MIT"
}
